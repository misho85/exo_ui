#!/bin/sh
# Sourced by EVERY `bin/exo_ui_storybook` command (start, eval, rpc, remote) before the
# release script applies its own `${VAR:-default}` values.
#
# Erlang distribution and epmd on loopback only (KRF-493, KRF-509).
#
# Without this file the release listens on `0.0.0.0:4369` and `[::]:4369`
# (epmd) and on `0.0.0.0:<random port>` (distribution). The container is on
# `dokploy-network`, which every project's containers on the box share, so any
# of them could reach both ports, and only the cookie stood between them and
# full access to the node, code execution included. The storybook is public
# and has no cluster and no `DNSCluster`. Distribution is there for
# `bin/exo_ui_storybook rpc` and `remote` from inside the container, and
# loopback is enough for that.
#
# Three things, and each one is needed:
#
#   * `ERL_EPMD_ADDRESS` binds epmd. The first BEAM that starts distribution
#     starts epmd, and epmd inherits this file's environment.
#   * `-kernel inet_dist_use_interface {127,0,0,1}` in `vm.args.eex` (start)
#     and in `remote.vm.args.eex` (rpc, remote) binds the distribution port.
#   * A node name with `127.0.0.1` as its host part, hence `name` (long
#     names). Under the default `sname` the node is `exo_ui_storybook@<hostname>`, and
#     `rpc` looks for epmd on the hostname's address (the container IP) and
#     gets `econnrefused`. The hostname stays in the NAME part, as in every
#     fleet release (there it is Oban's node name, `attempted_by` and `ident`),
#     so the old and the new container of a start-first deploy stay two nodes.
#
# Exported unconditionally, not `${VAR:-…}`: a variable from the Dokploy env
# or an `ENV` in the Dockerfile must not quietly put the listeners back on
# every interface. Standard: Pogon › Tehnički standardi › Isporuka › Dokploy ›
# "Erlang distribucija i epmd samo na loopback-u"; reference: pogon `apps/api/rel/`.

_host="$(cat /proc/sys/kernel/hostname 2>/dev/null || hostname)"

export RELEASE_DISTRIBUTION=name
export RELEASE_NODE="<%= @release.name %>-$(printf %s "$_host" | tr -c 'A-Za-z0-9_-' _)@127.0.0.1"
export ERL_EPMD_ADDRESS=127.0.0.1

unset _host
